{
  "name": "capstone/egg-production-inventory-system",
  "type": "project",
  "require": {
    "php": "^8.2|^8.3|^8.4|^8.5",
    "laravel/framework": "^12.0|^13.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"setup": ["php artisan key:generate", "php artisan migrate --seed"]}
}
